POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=real_estate_data
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend Configuration (mapped via docker-compose)
# DANGER: set to 1 ONLY on your local machine, NEVER in production
FLASK_DEBUG=0
SECRET_KEY=your-secret-key
RATELIMIT_STORAGE_URI=memory://

# Caching (set CACHE_TYPE=RedisCache and provide CACHE_REDIS_URL in production)
CACHE_TYPE=SimpleCache
CACHE_REDIS_URL=redis://localhost:6379/0
MAX_MAP_PINS=5000

# Seed Users (used by flask seed-users command)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=your_admin_password
SEED_ANALYST_EMAIL=analyst@example.com
SEED_ANALYST_PASSWORD=your_analyst_password
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=your_user_password